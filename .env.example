# Copy this file to ".env" and fill in your values.
# Get a free Gemini API key at: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# Model names (override if you like)
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Flask
SECRET_KEY=change-me-to-a-random-string
FLASK_DEBUG=true

# --- Firebase (auth) ---
# From Firebase Console -> Project settings -> Your apps -> Web app (SDK config).
# These are PUBLIC values, safe to expose to the browser.
# Leave blank to run the app open (no login) until you're ready.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Server-side verification also needs a service-account key
# (Console -> Service accounts -> Generate new private key). Save it as either
# firebase-key.json in the project root, OR drop the downloaded file into a
# firebase/ folder — Miki picks up the first *.json it finds there.
